<?xml version="1.0" encoding="utf-8"?>
<!-- Eine Zeile pro Produkt. Jede Zeile hat dieselben ids – die Tests suchen deshalb erst die Zeile
     (über ihre Beschreibung "Produkt <Name>") und darin die Elemente. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/name"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/preis"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp" />

    <TextView
        android:id="@+id/menge"
        android:layout_width="32dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="0" />

    <Button
        android:id="@+id/hinzufuegen"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:text="@string/hinzufuegen" />
</LinearLayout>
